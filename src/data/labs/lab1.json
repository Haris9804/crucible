{
  "id": 1,
  "slug": "installation-setup-windows",
  "title": "Installation Setup For Windows User",
  "description": "Setup virtualization environment and install Kali Linux.",
  "difficulty": "Beginner",

  "phases": [

    {
      "id": 1,
      "title": "CHECK VIRTUALIZATION",
      "sub":"System pre-check",
      "objective": "Verify that your system supports hardware virtualization before installing any virtual machines.",
      "status": "incomplete",

      "blocks": [

        {
          "type": "warning",
          "content": "Checking for system virtualization is important"
        },

        {
          "type": "requirements",

          "title": "System Pre-requisites",

          "items": [
            "Windows 10 or Windows 11",
            "Minimum 4 GB RAM",
            "Access to Task Manager (Ctrl+Shift+Esc)",
            "Admin access to BIOS settings (if needed)"
          ]
        },

        {
          "type": "steps",

          "title": "Step 1: Open Task Manager",

          "items": [
            "Press Ctrl+Shift+Esc (Task Manager) to open Task Manager",
            "Click on the Performance tab at the top",
            "Click on CPU in the left panel"
          ]
        },

        {
          "type": "steps",

          "title": "Step 2: Check System Virtualization",

          "items": [
            "Scroll down to the bottom of the CPU details panel",
            "Look for the line: Virtualization: Enabled",
            "If Enabled — this phase is complete, proceed to Phase 2",
            "If Disabled — follow the steps below to enable it"
          ]
        },

        {
          "type": "steps",

          "title": "If Not Enabled — Enable in BIOS",

          "items": [
            "Restart your laptop and boot into BIOS settings",
            "Navigate to Configuration or Advanced tab",
            "Find Virtualization Technology or VT-x and Enable it",
            "Save changes and reboot the system"
          ]
        },

        {
          "type": "links",

          "title": "Youtube References",

          "items": [
            "https://www.youtube.com/shorts/56rVqkO4uuE",
            "https://www.youtube.com/watch?v=LQIyowZMiY8"
          ]
        }

      ]
    },

    {
