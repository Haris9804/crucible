                    "Click Install",
                    "Wait for installation",
                    "Click Finish"
                  ]
                },

                {
                  "type": "steps",

                  "title": "Step 4: Install Extension Pack",

                  "items": [
                    "Open Downloads folder",
                    "Open Extension Pack",
                    "Click Install",
                    "Accept agreement"
                  ]
                }

              ]
            }

          ]
        },

