# Copy to .env for local dev (gitignored). On Render, set these in the dashboard.

# MongoDB Atlas connection string (Atlas → Connect → Drivers → Node.js).
# Replace USER/PASSWORD and the cluster host. The db name is taken from MONGODB_DB below.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0

# Database name inside the cluster.
MONGODB_DB=ctf

# Long random string used to sign session cookies. Generate one, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Set to "production" when deployed (enables secure cookies). Leave unset locally.
# NODE_ENV=production

# Port the API listens on (Render injects PORT automatically; default 4000 locally).
# PORT=4000
